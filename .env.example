POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
# Free LLM (optional). Providers: groq | gemini | openrouter (any OpenAI-compatible API via LLM_BASE_URL)
# Keys: console.groq.com, aistudio.google.com, openrouter.ai. Leave LLM_API_KEY empty to use retrieval-only answers.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
# Optional: neural embeddings (free Gemini key from aistudio.google.com), real emails, public site address
EMBED_API_KEY=
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
